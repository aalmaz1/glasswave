{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GlassWave",
  "version": "1.0.0",
  "identifier": "com.glasswave.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GlassWave",
        "width": 1280,
        "height": 800,
        "minWidth": 380,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "category": "Utility",
    "shortDescription": "Glassmorphism notes app",
    "longDescription": "GlassWave — notes app with a glassmorphism UI. Syncs through Firebase, works offline.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
