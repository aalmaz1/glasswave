{
  "name": "glasswave",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:export": "tsx scripts/export-i18n.ts",
    "sound:ios": "node scripts/mp3-to-ios-sound.mjs",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:sync:ios": "npm run build && npx cap sync ios",
    "android:apk": "npm run cap:sync && cd android-capacitor && ./gradlew assembleRelease",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "firebase": "^13.2.0",
    "lucide-react": "^1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^31.0.0",
    "mpg123-decoder": "^1.0.3",
    "prettier": "^3.9.6",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7",
    "workbox-build": {
      "glob": "14.0.4"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.6"
    },
    "@rollup/plugin-node-resolve": {
      "deepmerge": "3.2.1"
    },
    "eslint": {
      "minimatch": "11.0.6"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.6"
    }
  },
  "allowScripts": {
    "@tailwindcss/oxide@4.3.5": true,
    "esbuild@0.28.2": true,
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true
  }
}
