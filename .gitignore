# ==============================================================================
# Glasswave Monorepo Root .gitignore
# Stack: Vite / React / TypeScript / Capacitor (Android/iOS) / Tauri / Flutter
# ==============================================================================

# Node.js & Web Dependencies
node_modules/
.npm/
.pnpm-store/
.yarn/
.vite/
.turbo/
*.tsbuildinfo
.eslintcache
.stylelintcache

# Environment & Secret Files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
.env.*
!.env.example

# Build Outputs & Bundles
dist/
dist-ssr/
build/
target/
**/target/
**/gen/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing & Coverage
coverage/
htmlcov/
.mypy_cache/
.pytest_cache/

# Android & Gradle (Global fallback)
.gradle/
**/local.properties
**/captures/
**/.externalNativeBuild
**/.cxx/
*.apk
*.aab
*.dex
*.keystore
*.jks

# iOS & Xcode (Global fallback)
**/DerivedData/
**/xcuserdata/
*.mode1v3
*.mode2v3
*.moved-aside
*.pbxuser
*.perspectivev3

# Flutter & Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
*.iml
*.ipr
*.iws

# Editors & IDEs
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.swp
*.swo
*.tmp
*.bak

# OS System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Archives & Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
